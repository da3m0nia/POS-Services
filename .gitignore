# ============================================================
# POS Services — Git ignore rules
# ============================================================

# Dependencies
node_modules/

# Cloudflare / Wrangler
.wrangler/

# Environment variables and secrets
.dev.vars
.env
.env.*

# Wrangler configuration (contains database_id and can hold vars)
wrangler.toml
wrangler.toml.local
wrangler.toml.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts (if any tooling is added later)
dist/
build/
.cache/
