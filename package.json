{
  "name": "pos-services",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Telegram bot for POS (card reader) device management — Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail pos-services",
    "db:migrate": "wrangler d1 migrations apply pos-services-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply pos-services-db --local"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18"
  }
}
